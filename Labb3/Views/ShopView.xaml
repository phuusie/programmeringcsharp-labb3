<UserControl
    x:Class="Labb3ProgTemplate.Views.ShopView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Labb3ProgTemplate.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:products="clr-namespace:Labb3ProgTemplate.DataModels.Products"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    d:DataContext="{d:DesignInstance Type=products:Product}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="Garamond"
    FontSize="20"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="ProductTypesEnum"
            MethodName="GetValues"
            ObjectType="{x:Type local:ProductTypes}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:ProductTypes" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <TextBlock
            Name="UserName"
            Grid.Column="1"
            HorizontalAlignment="Center"
            FontSize="28"
            FontStyle="Italic"
            FontWeight="Bold"
            Foreground="Maroon" />
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                Content="Products"
                FontWeight="Bold"
                Foreground="Maroon" />
            <ComboBox
                Name="ProductTypeComboBox"
                Grid.Column="1"
                Width="150"
                Height="25"
                HorizontalAlignment="Right"
                FontSize="16"
                Foreground="DarkRed"
                ItemsSource="{Binding Source={StaticResource ProductTypesEnum}}"
                SelectionChanged="ProductTypeComboBox_OnSelectionChanged" />
        </Grid>
        <ListBox
            Name="ProdList"
            Grid.Row="2"
            Grid.Column="1"
            BorderThickness="2,2,1,2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Name="ProductIconTextBox"
                            Width="25"
                            Height="25"
                            Source="{Binding Icon}" />
                        <TextBlock Text="  " />
                        <TextBlock Width="120" Text="{Binding Name}" />
                        <TextBlock Text="{Binding Price}" />
                        <TextBlock Text="kr" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button
            Name="AddBtn"
            Grid.Row="3"
            Grid.Column="1"
            Height="30"
            Margin="20,5"
            Click="AddBtn_Click">
            Add
        </Button>
        <Label
            Grid.Row="1"
            Grid.Column="2"
            HorizontalAlignment="Center"
            Content="Cart"
            FontWeight="Bold"
            Foreground="Maroon" />
        <ListBox
            Name="CartList"
            Grid.Row="2"
            Grid.Column="2"
            BorderThickness="1,2,2,2"
            ItemsSource="{Binding Cart}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Name="ProductIconTextBox"
                            Width="25"
                            Height="25"
                            Source="{Binding Icon}" />
                        <TextBlock Text="  " />
                        <TextBlock Width="120" Text="{Binding Name}" />
                        <TextBlock Text="{Binding Price}" />
                        <TextBlock Text="kr" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel
            Grid.Row="3"
            Grid.Column="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Name="RemoveBtn"
                Width="150"
                Height="30"
                Margin="10,0"
                Click="RemoveBtn_Click">
                Remove
            </Button>
            <Button
                Name="ClearBtn"
                Width="150"
                Height="30"
                Margin="10,0"
                Click="ClearBtn_OnClick">
                Clear Cart
            </Button>
        </StackPanel>
        <Button
            Name="LogoutBtn"
            Grid.Row="4"
            Grid.Column="1"
            Width="100"
            Margin="10"
            Click="LogoutBtn_Click">
            Log Out
        </Button>
        <Button
            Name="CheckoutBtn"
            Grid.Row="4"
            Grid.Column="2"
            Width="100"
            Margin="10"
            Click="CheckoutBtn_Click">
            Checkout
        </Button>
    </Grid>
</UserControl>
